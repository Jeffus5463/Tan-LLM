OLLAMA_VERSION=0.33.2
OLLAMA_MODEL=qwen3.5:4b

AUTH_USERNAME=owner
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# Trusted home LAN only. HTTP does not encrypt credentials or chat traffic.
COOKIE_SECURE=false
ALLOW_LAN_HTTP=true

# Leave empty until the web proxy exists; list only its Docker-side IP addresses.
TRUSTED_PROXY_IPS=

# Reserved laptop LAN IPv4 address; used when the web service is added.
LAN_HOST_IP=
