OLLAMA_VERSION=0.33.2
OLLAMA_MODEL=qwen3.5:4b
# Optional image version for the production web server.
NGINX_VERSION=1.29-alpine
# Optional comma-separated models. Only installed entries are shown in the app.
OLLAMA_ALLOWED_MODELS=

AUTH_USERNAME=owner
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# Trusted home LAN only. HTTP does not encrypt credentials or chat traffic.
COOKIE_SECURE=false
ALLOW_LAN_HTTP=true

# The proxy address must match WEB_PROXY_IP.
TRUSTED_PROXY_IPS=172.28.50.2
WEB_PROXY_IP=172.28.50.2
APP_NETWORK_SUBNET=172.28.50.0/24
APP_DYNAMIC_IP_RANGE=172.28.50.128/25

# Reserved laptop LAN IPv4 address, for example 192.168.1.50.
LAN_HOST_IP=192.168.1.50
